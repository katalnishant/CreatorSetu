# Copy this to a file literally named ".env" at the repo root (same folder
# as docker-compose.yml). docker-compose reads it automatically. It's
# already covered by .gitignore's ".env" / ".env.*" rules — never commit
# the real one.

DB_NAME=creatorsetu
DB_PASSWORD=pick-a-strong-password

JWT_SECRET_KEY=replace-with-a-long-random-string

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
